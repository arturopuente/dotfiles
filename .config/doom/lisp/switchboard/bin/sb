#!/bin/sh
# sb: lets an agent in a Switchboard session start and steer other agents.
# Switchboard puts this folder on each session's PATH. `sb --skill` is the
# manual agents read. Arguments reach Emacs through a file that it only reads
# as strings, so nothing in a task can run as code.

manual() {
  cat <<'EOF'
sb starts other coding agents as helpers, each in its own terminal, listed
under you in the user's sidebar.

  sb run [--worktree] [--agent claude|codex|pi] [--name NAME] [--keep] "task"
      Start a helper and return right away. It runs the same agent as you
      unless you pass --agent.
  sb ls                      List your helpers.
  sb read NAME [--lines N]   Show the end of a helper's terminal (default 50).
  sb send NAME "text"        Type a message into a helper.
  sb wait NAME [--timeout S] Block until it finishes (default 100 seconds).
                             Exits 3 if it is still running.
  sb stop NAME               Stop a helper and clean up after it.
  sb keep NAME               Keep a finished helper around for follow-ups.
  sb release NAME            Undo keep; it is cleaned up like any other.
  sb report "result"         If you are a helper, give your parent your result.

Where it runs:
  Use --worktree for anything that edits files. The helper gets its own branch
  and folder, starting from your last commit, so it cannot see uncommitted
  work: commit first if it needs that. Merge its branch when it finishes.
  Without --worktree it shares your folder and sees your current files. Use
  that for read-only work such as reviews and research.

Getting results:
  You do not need to wait. When a helper finishes and you are idle, its result
  is typed into your session as <sb from="NAME">...</sb>. End your turn if you
  have nothing else to do. Use sb wait only when you must have the result to
  continue. An agent tool's own timeout may be shorter than a long wait.

If you are a helper: finish by running sb report with your result, and name
your branch if you used a worktree.

Cleanup:
  About a minute after you get its result, a helper is removed, along with its
  worktree and branch if they are merged and clean. Use sb keep to send it
  follow-ups. Unmerged work is never deleted; the helper stays listed until you
  merge it or run sb stop, which leaves the branch in place.

Limits: helpers can start helpers one level down, and a whole tree can have 10
running at once. You can only reach helpers you started. Permission prompts are
for the user: sb send refuses to answer them.
EOF
}

case "$1" in
  --skill) manual; exit 0 ;;
  ""|-h|--help) manual | sed -n '4,15p'; exit 0 ;;
esac

if [ -z "$SWITCHBOARD_ID" ] || [ -z "$SWITCHBOARD_SB_DIR" ]; then
  echo "sb: only works inside a Switchboard session" >&2
  exit 2
fi

# Requests go through a folder Emacs watches, not its socket: an agent's
# sandbox (Codex's, for one) can be told it may write to a folder, but it
# can't reach a socket.
base=$(mktemp "$SWITCHBOARD_SB_DIR/$SWITCHBOARD_ID--XXXXXXXX") || {
  echo "sb: can't write to $SWITCHBOARD_SB_DIR" >&2
  exit 2
}
reply=$base.reply
trap 'rm -f "$base" "$base.tmp" "$base.req" "$reply"' EXIT

for a in "$@"; do
  printf '"%s"\n' "$(printf '%s' "$a" | sed 's/\\/\\\\/g; s/"/\\"/g')"
done > "$base"

# Sets $code; Emacs writes the code and the text to $reply.
ask() {
  rm -f "$reply"
  cp "$base" "$base.tmp" && mv "$base.tmp" "$base.req"
  tries=0
  while [ ! -f "$reply" ]; do
    tries=$((tries + 1))
    if [ "$tries" -gt 600 ]; then
      rm -f "$base.req"
      echo "sb: Emacs didn't answer" >&2
      exit 2
    fi
    sleep 0.1
  done
  code=$(sed -n 1p "$reply")
}

finish() {
  if [ "$code" = 0 ]; then sed 1d "$reply"; else sed 1d "$reply" >&2; fi
  exit "$code"
}

ask
if [ "$1" = wait ]; then
  # Emacs must not block, so poll it. Exit 3 means still running.
  timeout=100
  prev=
  for a in "$@"; do
    [ "$prev" = --timeout ] && timeout=$a
    prev=$a
  done
  case "$timeout" in ''|*[!0-9]*) echo "sb: --timeout needs a number of seconds" >&2; exit 2 ;; esac
  start=$(date +%s)
  while [ "$code" = 3 ] && [ $(( $(date +%s) - start )) -lt "$timeout" ]; do
    sleep 2
    ask
  done
fi

finish
